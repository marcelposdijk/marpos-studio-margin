    "astro": "^7.2.0",
    "autoprefixer": "^10.5.4",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.7",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "pagefind": "^1.5.2",
    "wrangler": "^4.115.0"
