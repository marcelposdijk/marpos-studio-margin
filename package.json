{
  "name": "marpos-studio-margin",
  "type": "module",
  "version": "1.1.0",
  "description": "An English-language Margin publication demonstrating Marpos Studio with Astro.",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro sync && astro build && npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
