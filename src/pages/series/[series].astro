---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Badge from '../../components/Badge.astro';
import config from '../../config.json';
import { formatDate } from '../../lib/dates';
import { getAllPosts, type CMSPost } from '../../lib/content';

const seriesSlug = Astro.params.series as string;
const posts = await getAllPosts();
const allSeriesPosts = posts.filter(p => p.series && p.series.toLowerCase().replace(/\s+/g, '-') === seriesSlug);

if (allSeriesPosts.length === 0) {
	return Astro.redirect('/404');
}

const seriesName = allSeriesPosts[0].series!;
const sortedPosts = allSeriesPosts.sort((a, b) => (a.series_order || 0) - (b.series_order || 0));
---

<Layout title={`${seriesName} — Series — ${config.siteTitle}`} description={`The ${seriesName} series, ${sortedPosts.length} parts.`}>
	<PageHeader kicker="Series" title={seriesName} desc={`${sortedPosts.length} ${sortedPosts.length === 1 ? 'part' : 'parts'} in this series.`} />
	<section class="max-w-[860px] mx-auto px-5 md:px-8 pb-16 md:pb-20">
		<div class="series-timeline">
			{sortedPosts.map((post, i) => (
				<a href={`/posts/${post.slug}`} class="series-timeline__item group">
					<div class="series-timeline__node">
						<span class="series-timeline__num font-mono">{String(i + 1).padStart(2, '0')}</span>
						<div class="series-timeline__dot"></div>
					</div>
					<div class="series-timeline__content">
						<div class="flex items-center gap-2 mb-1">
							<Badge>{post.category}</Badge>
							<span class="font-mono text-[10px] text-faint">{formatDate(post.pubDate)}</span>
						</div>
						<h3 class="font-serif text-[18px] md:text-[22px] font-bold leading-[1.25] tracking-tight text-ink group-hover:text-accent-soft transition-colors mb-1">
							{post.title}
						</h3>
						<p class="text-[13px] text-muted leading-[1.55]">{post.description}</p>
					</div>
				</a>
			))}
		</div>
	</section>
</Layout>

<style>
	.series-timeline { position: relative; padding-left: 0; }
	.series-timeline::before { content: ''; position: absolute; left: 19px; top: 12px; bottom: 12px; width: 1px; background: var(--c-border); }
	.series-timeline__item { display: flex; gap: 1.25rem; padding-bottom: 2rem; position: relative; }
	.series-timeline__node { position: relative; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; width: 40px; }
	.series-timeline__num { font-size: 11px; color: var(--c-faint); margin-bottom: 0.4rem; }
	.series-timeline__dot { width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--c-border); background: var(--c-bg); position: relative; z-index: 1; transition: border-color 0.2s, background 0.2s; }
	.series-timeline__item:hover .series-timeline__dot { border-color: var(--c-accent); background: var(--c-accent); }
	.series-timeline__content { flex: 1; min-width: 0; padding-bottom: 0.5rem; }
</style>
