---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---

<Layout title="Subscribe — Margin" description="Subscribe to Margin for weekly stories worth reading.">
	<PageHeader
		kicker="Newsletter"
		title="One email per week."
		titleEmphasis="No noise."
		desc="A sample signup page for the Margin publication. Subscriptions are not connected in this demo."
	/>

	<section class="max-w-[680px] mx-auto px-5 md:px-8 pb-14 md:pb-20">
		<NewsletterForm compact buttonText="Demo only" />
		<p class="text-[12px] text-faint font-mono text-center mt-6">
			Demonstration only. No email addresses are collected.
		</p>
	</section>
</Layout>
