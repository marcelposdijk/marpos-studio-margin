---
import { withBase } from '../../lib/urls';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import SocialShare from '../../components/SocialShare.astro';
import BackLink from '../../components/BackLink.astro';
import Badge from '../../components/Badge.astro';
import Avatar from '../../components/Avatar.astro';
import Icon from '../../components/Icon.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import SeriesBar from '../../components/SeriesBar.astro';
import config from '../../config.json';
import { formatDate } from '../../lib/dates';
import { estimateReadingTime } from '../../lib/readingTime';
import { getAllPosts, getPostBySlug, renderMarkdown, contentMode, type CMSPost } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getCollection('posts');
  return entries.filter(entry => import.meta.env.DEV || !entry.data.draft)
    .map(entry => ({ params: { slug: entry.id } }));
}

const slug = Astro.params.slug as string;
const post = await getPostBySlug(slug);

if (!post) {
	return Astro.redirect('/404');
}

const allPosts = await getAllPosts();
const related = allPosts
	.filter(p => p.category === post.category && p.slug !== post.slug)
	.slice(0, 3);

const readMins = post.reading_time || estimateReadingTime(post.body);
const html = renderMarkdown(post.body);

// Extract h2/h3 from rendered HTML for TOC
const headingRegex = /<h([23])[^>]*id="([^"]*)"[^>]*>(.*?)<\/h\1>/gi;
const tocHeadings: { depth: number; slug: string; text: string }[] = [];
let m;
const cleanText = (h: string) => h.replace(/<[^>]+>/g, '');
while ((m = headingRegex.exec(html)) !== null) {
	tocHeadings.push({ depth: parseInt(m[1]), slug: m[2], text: cleanText(m[3]) });
}

const seriesPosts = post.series
	? allPosts.filter(p => p.series === post.series)
	: [];

function toCardPost(p: CMSPost) {
	return { slug: p.slug, data: {
		title: p.title, description: p.description, pubDate: p.pubDate,
		author: p.author, category: p.category, tags: p.tags, featured: p.featured,
		image: p.cover_url ? { url: p.cover_url, alt: p.cover_alt || '' } : undefined,
	}};
}
---

<Layout title={post.title} description={post.description}>
	<article class="max-w-[1280px] mx-auto px-5 md:px-8 py-10 md:py-14">
		<BackLink href={withBase("/")}>Back to home</BackLink>

		<div class="flex flex-col lg:grid lg:grid-cols-12 lg:gap-12">
			<div class="col-span-12 lg:col-span-8 lg:col-start-1 min-w-0">
				<header class="max-w-[680px] mb-12">
					<div class="flex items-center gap-3 mb-4">
						<Badge>{post.category}</Badge>
						<span class="font-mono text-[11px] text-faint">
							{formatDate(post.pubDate)}
						</span>
					</div>
					<h1 class="font-serif text-[28px] sm:text-[36px] md:text-[42px] font-bold leading-[1.15] tracking-tight text-ink mb-6">
						{post.title}
					</h1>
					<div class="flex items-center gap-3 pt-4 border-t border-[var(--c-border)]">
						{config.enableAuthor && (
							<div class="flex items-center gap-2.5 text-[13px] text-body">
								<Avatar name={post.author} size={26} />
								By <a href={withBase(`/author/${post.author}`)} class="font-medium text-ink hover:text-accent-soft transition-colors">{post.author}</a>
							</div>
						)}
						<span class="text-faint">·</span>
						<span class="font-mono text-[11px] text-faint flex items-center gap-1">
							<Icon name="clock" size={12} stroke={true} />
							{readMins} min read
						</span>
						<span class="text-faint">·</span>
						<span class="font-mono text-[11px] text-faint flex items-center gap-1" id="busuanzi_container_page_pv" style="display:none">
							<Icon name="eye" size={12} stroke={true} />
							<span id="busuanzi_value_page_pv"></span> views
						</span>
						{post.tags && post.tags.length > 0 && (
							<span class="hidden sm:flex items-center gap-1.5 ml-auto">
								{post.tags.map(tag => (
									<a href={withBase(`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`)}
										class="font-mono text-[10px] text-muted hover:text-accent-soft transition-colors">
										#{tag}
									</a>
								))}
							</span>
						)}
					</div>
				</header>

				{post.cover_url && (
					<div class="max-w-[800px] mb-12 rounded-[3px] overflow-hidden">
						<img sizes="(min-width: 1024px) 800px, calc(100vw - 40px)" src={withBase(post.cover_url)} alt={post.cover_alt || post.title}
							class="w-full h-auto object-cover max-h-[500px]" loading="eager" />
					</div>
				)}

				<div class="prose mx-auto max-w-none" style="max-width:680px;" data-pagefind-body set:html={html}>
				</div>

				{seriesPosts.length > 0 && post.series && (
					<div class="max-w-[680px] mt-16">
						<SeriesBar
							posts={seriesPosts.map(toCardPost) as any}
							currentSlug={post.slug}
							seriesName={post.series}
						/>
					</div>
				)}

				<div class="max-w-[680px] mt-16 pt-8 border-t border-[var(--c-border)] flex items-center gap-4">
					<span class="text-[13px] text-body">Share:</span>
					<SocialShare />
				</div>

				{related.length > 0 && (
					<div class="max-w-[800px] mt-16">
						<div class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted mb-5">Related Stories</div>
						<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
							{related.map(r => (
								<PostCard post={toCardPost(r) as any} />
							))}
						</div>
					</div>
				)}
			</div>

			<TableOfContents headings={tocHeadings as any} />
		</div>
	</article>

	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Article",
		headline: post.title,
		description: post.description,
		datePublished: post.pubDate.toISOString(),
		author: { "@type": "Person", name: post.author },
		publisher: { "@type": "Organization", name: config.siteTitle },
		articleSection: post.category,
	})} />
</Layout>
