---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import Avatar from '../../components/Avatar.astro';
import config from '../../config.json';
import { getAllPosts, type CMSPost } from '../../lib/content';

const authorParam = Astro.params.author as string;
const posts = await getAllPosts();
const matched = posts.filter(p => p.author === authorParam);

if (matched.length === 0) {
	return Astro.redirect('/404');
}

const author = matched[0].author;
const sortedPosts = matched.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

function toCardPost(p: CMSPost) {
	return { slug: p.slug, data: {
		title: p.title, description: p.description, pubDate: p.pubDate,
		author: p.author, category: p.category, tags: p.tags, featured: p.featured,
		image: p.cover_url ? { url: p.cover_url, alt: p.cover_alt || '' } : undefined,
	}};
}
---

<Layout title={`${author} - ${config.siteTitle}`} description={`Stories by ${author}.`}>
	<section class="max-w-[1280px] mx-auto px-5 md:px-8 pt-10 md:pt-14 pb-10 md:pb-12">
		<div class="flex items-center gap-5 mb-6">
			<Avatar name={author} size={52} />
			<div>
				<div class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted mb-1">Author</div>
				<h1 class="font-serif text-[28px] md:text-[36px] font-bold tracking-tight text-ink">{author}</h1>
			</div>
		</div>
		<p class="text-[16px] text-body max-w-[500px]">
			{sortedPosts.length} {sortedPosts.length === 1 ? 'story' : 'stories'} by this author.
		</p>
	</section>
	<section class="max-w-[1280px] mx-auto px-5 md:px-8 pb-16 md:pb-20">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			{sortedPosts.map((post) => (
				<PostCard post={toCardPost(post) as any} />
			))}
		</div>
	</section>
</Layout>
