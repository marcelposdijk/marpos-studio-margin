---
--- 

<button id="theme-toggle" type="button" class="theme-toggle" aria-label="Toggle theme">
	<!-- Sun (show in dark mode) -->
	<svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
		<circle cx="12" cy="12" r="4" />
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
	</svg>
	<!-- Moon (show in light mode) -->
	<svg class="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
		<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
	</svg>
</button>

<style is:global>
	[data-theme="dark"] .theme-icon-sun { display: block; }
	[data-theme="dark"] .theme-icon-moon { display: none; }
	[data-theme="light"] .theme-icon-sun { display: none; }
	[data-theme="light"] .theme-icon-moon { display: block; }
</style>

<script>
	function initThemeToggle() {
		const btn = document.getElementById('theme-toggle');
		if (!btn) return;
		// Guard against double-binding across View Transitions
		if (btn.dataset.bound === '1') return;
		btn.dataset.bound = '1';

		btn.addEventListener('click', () => {
			const html = document.documentElement;
			const current = html.getAttribute('data-theme');
			const next = current === 'dark' ? 'light' : 'dark';
			html.setAttribute('data-theme', next);
			localStorage.setItem('margin-theme', next);
			const meta = document.querySelector('meta[name="theme-color"]');
			if (meta) meta.setAttribute('content', next === 'dark' ? '#0e0a0c' : '#faf8f6');
		});
	}

	document.addEventListener('astro:page-load', initThemeToggle);
</script>
